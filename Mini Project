class Bank(
    private var bankName: String,
    private var customers: MutableList<Customer>,
    private var employees: MutableList<Employee>,
) {
    fun addCustomer(customer: Customer) {
        customers.add(customer)
    }
    fun removeCustomer(customerId: String) {
        for (customer in customers){
            if (customer.getCustomerId() == customerId){
                customers.remove(customer)
            }
        }
    }
    fun findCustomer(customerId: String): Customer? {
        for (customer in customers){
            if (customer.getCustomerId() == customerId){
                return customer
            }
        }
        println("Customer not found")
        return null
    }
    fun generateBankReport(){
        println("$bankName Report:")
        println("Total customers: ${customers.size}")
        println("Total employees: ${employees.size}")
        println("Total bank holdings: ${calculateTotalBankHoldings()}")
        println("-------------------------")
        for (customer in customers){
            customer.printCustomerDetails()
            println("------------------------")
        }
    }
    fun calculateTotalBankHoldings(): Double{
        var totalHoldings = 0.0
        for (customer in customers){
            totalHoldings += customer.getTotalBalance()
        }
        return totalHoldings
    }
}

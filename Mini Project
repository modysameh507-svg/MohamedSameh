class Customer (
    private var customerId: String,
    private var fullName: String,
    private var nationalId: String,
    private var phoneNumber: String,
    private var address: String,
    private var accounts: MutableList<Account>
){
    fun getCustomerId(): String{
        return customerId
    }
    fun openAccount(account: Account){
        accounts.add(account)
    }
    fun closeAccount(accountNumber: String){
        var flag: Boolean = false
        for (acc in accounts){
            if (acc.getAccountNumber() == accountNumber){
                flag = true
                acc.closeAccount()
                break
            }
        }
        if (!flag) println("Account not found")
    }
    fun getTotalBalance(): Double{
        var sum: Double = 0.0
        for (acc in accounts){
            sum += acc.getBalance()
        }
        return sum
    }
    fun printCustomerDetails(){
        println("Customer Details:")
        println("ID: $customerId")
        println("Name: $fullName")
        println("NationalId: $nationalId")
        println("phoneNumber: $phoneNumber")
        println("address: $address")
        println("Accounts summary:")
        println("The number of accounts: ${accounts.size}")
        for (acc in accounts){
            println("account number: ${acc.getAccountNumber()}")
            println("balance ${acc.getBalance()}")
            println("openedDate: ${acc.getOpenedDate()}")
            if (acc.getstatus()) println("Status: Activated")
            else println("Status: Not Activated")
            println()
        }
    }
}

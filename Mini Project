abstract class Account(
    protected var accountNumber: String,
    protected var balance: Double,
    protected var openedDate: String,
    protected var isActive: Boolean,
    protected var isforzen: Boolean
){
    fun freeze(){
        isforzen = true
    }
    fun unfreeze(){
        isforzen = false
    }
    fun getAccountNumber(): String{
        return accountNumber
    }
    fun getBalance(): Double{
        return balance
    }
    fun getOpenedDate(): String{
        return openedDate
    }
    fun getstatus(): Boolean{
        return isActive
    }
    fun deposit(amount: Double){
        if (isActive && !isforzen){
            if (amount > 0){
                balance += amount
                println("Balance Increase Successfully")
                println("Your balance is $balance")
            }
            else{
                println("Amount must be postitve")
            }
        }
        else{
            println("Error , Your account is inactive")
        }
    }
    abstract fun withdraw(amount: Double)

    fun transfer(amount: Double , targetAccount: Account){
        if (isActive && !isforzen){
            if (amount > balance){
                println("Insufficient balance")
            }
            this.withdraw((amount))
            targetAccount.deposit(amount)
        }
    }


    abstract fun calculateMonthlyInterest(): Double
    fun closeAccount(){
        if (balance == 0.0){
            isActive = false
            println("Account is closed successfully")
        }
        else {
            println("Balance must be zero to close account")
        }
    }
}
class SavingsAccount(
    private var interestRate:Double ,
    private var withdrawlthismonth:Int
):Account(accountNumber = "", balance = 0.0, openedDate = "", isActive = false , isforzen = false ) {
    override fun withdraw(amount: Double) {
        if (withdrawlthismonth > 3) {
            println("Withdrawl limit reached")
        }
        else{
            balance -= amount
            withdrawlthismonth++
        }
    }

    override fun calculateMonthlyInterest(): Double {
        return balance + interestRate
    }
}
class CurrentAccount(
    private var overdraft: Double
) : Account(accountNumber = "", balance = 0.0, openedDate = "", isActive = false , isforzen = false ) {
    override fun withdraw(amount: Double) {
        if (amount > overdraft + balance){
            println("overdraft limit exceeded")
        }
        else{
            balance -= amount
        }
    }
    override fun calculateMonthlyInterest(): Double {
        return 0.0
    }
}
class FixedDepositAccount(
